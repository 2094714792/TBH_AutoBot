        except Exception:
            pid.value = 0
        if pid.value == os.getpid():          # 前台是本程序（刚点了“开始”），可以直接切
            try:
                win32gui.SetForegroundWindow(hwnd)
                time.sleep(0.25)
                if win32gui.GetForegroundWindow() == hwnd:
                    self.log("已把游戏窗口切到前台")
                    return True
            except Exception:
                pass
        info = "?"
        try:
            info = "%s|%s" % (win32gui.GetClassName(fg), win32gui.GetWindowText(fg)[:24] or "-")
        except Exception:
            pass
        if time.time() - getattr(self, "_fg_log", 0) > 8:
            self._fg_log = time.time()
            self.log("提示：游戏窗口不在前台（当前前台：%s），已暂停点击。请点一下游戏画面让它到最前" % info)
        return False

    def _patch(self, img, box, pad=4):
        x, y, w, h = box
        H, W = img.shape[:2]
        x0, y0 = max(0, x - pad), max(0, y - pad)
        x1, y1 = min(W, x + w + pad), min(H, y + h + pad)
        return img[y0:y1, x0:x1].astype(np.int16)

    def step(self):
        cfg = self.cfg
        region = resolve_region(self.sct, cfg)
        img = grab(self.sct, region)
        cards = find_cards_tpl(img, cfg) or find_cards(img, cfg) or find_cards(img, cfg, loose=True)
        self.rounds += 1
        if cfg["debug"] and self.imgq.qsize() < 2:
            try:
                self.imgq.put_nowait(draw_debug(img, cards, region, "r%d" % self.rounds))
            except queue.Full:
                pass
        now = time.time()
        if now - self.last_fire < cfg["card_cd"]:
            return
        for c in cards:
            if cfg["blue_only"] and not c["blue"]:
                continue
            key = (round(c["center"][0] / 24.0), round(c["center"][1] / 24.0))
            if self.skip_until.get(key, 0) > now:
                continue
            self.fire(region, img, c, key)
            return
        if cards and not cfg["debug"]:
            pass

    def fire(self, region, img, card, key):
        cfg = self.cfg
        x, y, w, h = card["box"]
        cx, cy = card["center"]
        sx = region[0] + cx + random.randint(-2, 2)
        sy = region[1] + cy + random.randint(-2, 2)
        before = self._patch(img, card["box"])
        hwnd = cfg.get("hwnd")
        if hwnd:
            blocked, why = point_blocked(sx, sy, hwnd)
            if blocked:
                if self.skip_until.get(key, 0) <= time.time():
                    self.log("目标位置被 %s 遮挡，暂不点击" % why)
                self.skip_until[key] = time.time() + 3.0
                return
        pg.moveTo(sx, sy, duration=random.uniform(0.06, 0.14))
        pg.click()
        self.last_fire = time.time()
        self.clicks += 1
        self.log("点击[%s] 屏幕(%d,%d) 累计%d" % ("蓝框" if card["blue"] else "普通", sx, sy, self.clicks))
        time.sleep(0.35)
        after = grab(self.sct, region)
        pa = self._patch(after, card["box"])
        if pa.shape != before.shape or pa.size == 0:
            self.retry.pop(key, None)
            return
        diff = float(np.abs(pa - before).mean())
        if diff >= cfg["card_diff"]:
            self.hits += 1
            self.retry.pop(key, None)
        else:
            n = self.retry.get(key, 0) + 1
            self.retry[key] = n
            self.log("  画面未变化 diff=%.1f（%d/%d）" % (diff, n, cfg["max_retry"]))
            if n >= cfg["max_retry"]:
                self.retry.pop(key, None)
                self.skip_until[key] = time.time() + cfg["retry_cd"]
                self.log("!! 同一位置连续 %d 次无变化，跳过该位置 %.0fs" % (n, cfg["retry_cd"]))

    def run(self):
        cfg = self.cfg
        self.log("引擎启动")
        self.sct = new_sct()
        try:
            while not self._stop_evt.is_set():
                if self.paused:
                    time.sleep(0.2)
                    continue
                hwnd = cfg.get("hwnd")
                if hwnd:
                    if not win32gui.IsWindow(hwnd):
                        self.log("!! 目标窗口已关闭，引擎停止")
                        break
                    if not self._foreground_ok(hwnd):
                        time.sleep(0.8)
                        continue
                    rect = win32gui.GetWindowRect(hwnd) if win32gui.IsWindow(hwnd) else (0, 0, 0, 0)
                    if win32gui.IsIconic(hwnd) or (rect[1] < -3000 and rect[3] < -3000):
                        if time.time() - getattr(self, "_wait_log", 0) > 10:
                            self.log("窗口已最小化，等待中…")
                            self._wait_log = time.time()
                        time.sleep(1.0)
                        continue
                try:
                    self.step()
                    self.err_streak = 0
                except Exception as e:
                    self.err_streak += 1
                    msg = "%s: %s" % (type(e).__name__, e)
                    if msg != self.last_err or self.err_streak % 10 == 1:
                        self.log("!! 第 %d 次异常 %s" % (self.err_streak, msg))
                    self.last_err = msg
                    if self.err_streak >= 20:
                        self.log("!! 连续异常 20 次，停止引擎")
                        break
                    time.sleep(0.8)
                    try:
                        self.sct = new_sct()
                    except Exception:
                        pass
                    continue
                time.sleep(max(0.15, cfg["interval"] + random.uniform(-0.15, 0.25)))
        except Exception:
            self.log("异常:\n" + traceback.format_exc())
        finally:
            self.log("引擎已停止")
            self.logq.put(("stopped", None))


# ---------------- GUI ----------------
# 视觉规范（Fluent 风格深色）
BG       = "#1A1B1E"
PANEL    = "#232529"
PANEL2   = "#1C1E22"
BORDER   = "#33363C"
TEXT     = "#E7E9EC"
SUB      = "#9AA0A8"
ACCENT   = "#4CC2FF"
ACCENT_H = "#79D4FF"
OK       = "#6FD98B"
WARN     = "#F2C24B"
ERR      = "#FF6B6B"
FONT     = "Microsoft YaHei UI"
MONO     = "Consolas"


def _btn(parent, text, kind="ghost", cmd=None):
    """按钮：primary=实心主题色，ghost=描边次要"""
    if kind == "primary":
        b = tk.Button(parent, text=text, command=cmd, bg=ACCENT, fg="#0A1016",
                      activebackground=ACCENT_H, activeforeground="#0A1016",
                      relief="flat", bd=0, font=(FONT, 10, "bold"),
                      padx=20, pady=8, cursor="hand2")
    else:
        b = tk.Button(parent, text=text, command=cmd, bg=PANEL2, fg=TEXT,
                      activebackground="#2C2F35", activeforeground=TEXT,
                      relief="flat", bd=0, font=(FONT, 9),
                      padx=14, pady=7, cursor="hand2",
                      highlightthickness=1, highlightbackground=BORDER,
                      highlightcolor=ACCENT)
    b.bind("<Enter>", lambda e: b.config(bg="#2C2F35" if kind != "primary" else ACCENT_H))
    b.bind("<Leave>", lambda e: b.config(bg=PANEL2 if kind != "primary" else ACCENT))
    return b


class App(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("TBH 自动挂机助手 v1.2")
        self.geometry("1040x820")
        self.minsize(980, 720)
        self.configure(bg=BG)
        self.cfg = dict(DEFAULT)
        if os.path.exists(CFG_PATH):
            try:
                with open(CFG_PATH, encoding="utf-8") as f:
                    self.cfg.update(json.load(f))
            except Exception:
                pass
        self.logq, self.imgq = queue.Queue(), queue.Queue(maxsize=3)
        self.hotq = queue.Queue()
        self.eng = None
        self.panelbot = None
        self.windows = []
        self._sct = new_sct()
        self._tk = None
        self._style()
        self._build()
        self.refresh()
        self.after(120, self._poll)
        self.protocol("WM_DELETE_WINDOW", self._close)
        if "--start" in sys.argv:
            self.after(600, self.start)
        try:
            import keyboard
            self._kb = keyboard
            keyboard.hook(self._on_key)
            self.log("热键已启用：F8 暂停/继续，F12 停止")
        except Exception as e:
            self._kb = None
            self.log("热键启用失败（不影响按钮操作）: %s" % e)

    def _on_key(self, e):
        try:
            if e.event_type == "down" and e.name in ("f8", "f12"):
                self.hotq.put(e.name)
        except Exception:
            pass

    # ---- 视觉 ----
    def _style(self):
        st = ttk.Style(self)
            try:
            st.theme_use("clam")
        except Exception:
            pass
        st.configure("TCombobox", fieldbackground=PANEL2, background=PANEL2,
                     foreground=TEXT, arrowcolor=SUB, bordercolor=BORDER,
                     lightcolor=PANEL2, darkcolor=PANEL2, padding=5)
        st.map("TCombobox",
               fieldbackground=[("readonly", PANEL2), ("active", PANEL2)],
               foreground=[("readonly", TEXT)],
               selectbackground=[("readonly", PANEL2)],
               selectforeground=[("readonly", TEXT)],
               bordercolor=[("focus", ACCENT)])
        self.option_add("*TCombobox*Listbox.background", PANEL2)
        self.option_add("*TCombobox*Listbox.foreground", TEXT)
        self.option_add("*TCombobox*Listbox.selectBackground", ACCENT)
        self.option_add("*TCombobox*Listbox.selectForeground", "#0A1016")
        self.option_add("*TCombobox*Listbox.font", (FONT, 9))

    def _card(self, parent, title, sub=""):
        wrap = tk.Frame(parent, bg=BORDER)          # 1px 边框
        inner = tk.Frame(wrap, bg=PANEL)
        inner.pack(fill="both", expand=True, padx=1, pady=1)
        head = tk.Frame(inner, bg=PANEL)
        head.pack(fill="x", padx=14, pady=(10, 2))
        tk.Label(head, text=title, bg=PANEL, fg=TEXT, font=(FONT, 10, "bold")).pack(side="left")
        if sub:
            tk.Label(head, text=sub, bg=PANEL, fg=SUB, font=(FONT, 8)).pack(side="left", padx=(8, 0))
        body = tk.Frame(inner, bg=PANEL)
        body.pack(fill="both", expand=True, padx=14, pady=(4, 12))
        return wrap, body

    def _entry(self, parent, var, width=9):
        return tk.Entry(parent, textvariable=var, width=width, bg=PANEL2, fg=TEXT,
                        insertbackground=TEXT, relief="flat", bd=0,
                        font=(FONT, 9), justify="center",
                        highlightthickness=1, highlightbackground=BORDER,
                        highlightcolor=ACCENT)

    def _build(self):
        # 顶部标题 + 状态
        head = tk.Frame(self, bg=BG)
        head.pack(fill="x", padx=18, pady=(14, 6))
        tk.Label(head, text="TBH 自动挂机助手", bg=BG, fg=TEXT,
