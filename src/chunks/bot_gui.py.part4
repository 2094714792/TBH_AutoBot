                 font=(FONT, 17, "bold")).pack(side="left")
        tk.Label(head, text="宝箱卡片自动识别点击 v1.2", bg=BG, fg=SUB,
                 font=(FONT, 9)).pack(side="left", padx=(10, 0), pady=(7, 0))
        self.pill = tk.Label(head, text=" 停止 ", bg=BORDER, fg=TEXT,
                             font=(FONT, 9, "bold"), padx=10, pady=3)
        self.pill.pack(side="right")

        # ① 目标窗口 / 检测区域
        wrap1, b1 = self._card(self, "① 目标窗口与检测区域", "截图范围越小识别越稳")
        wrap1.pack(fill="x", padx=18, pady=(0, 8))
        self.cb = ttk.Combobox(b1, state="readonly")
        self.cb.pack(side="left", fill="x", expand=True, ipady=2)
        _btn(b1, "刷新", cmd=self.refresh).pack(side="left", padx=(8, 0))
        _btn(b1, "框选区域", kind="primary", cmd=self.select_region).pack(side="left", padx=(6, 0))
        _btn(b1, "清除区域", cmd=self.clear_region).pack(side="left", padx=(6, 0))
        _btn(b1, "测试识别", cmd=self.test).pack(side="left", padx=(6, 0))
        self.lbl_region = tk.Label(b1, text=self.region_text(), bg=PANEL, fg=SUB,
                                   font=(FONT, 8), anchor="w")
        self.lbl_region.pack(side="left", padx=(12, 0))
        self.follow = tk.BooleanVar(value=bool(self.cfg.get("follow", 1)))
        tk.Checkbutton(b1, text="跟随窗口右下角", variable=self.follow,
                       command=self._toggle_follow, bg=PANEL, fg=TEXT,
                       activebackground=PANEL, activeforeground=TEXT,
                       selectcolor=PANEL2, relief="flat", bd=0,
                       font=(FONT, 8), cursor="hand2").pack(side="left", padx=(10, 0))

        # ② 参数
        wrap2, b2 = self._card(self, "② 识别与点击参数")
        wrap2.pack(fill="x", padx=18, pady=(0, 8))
        self.vars = {}
        items = [("interval", "轮询间隔(s)", "0.3"), ("card_cd", "点击冷却(s)", "0.8"),
                 ("white_v", "白度阈值 V", "216"), ("white_s", "饱和度上限 S", "46"),
                 ("min_area", "卡片最小面积", "600"), ("max_area", "卡片最大面积", "9000"),
                 ("solid_min", "形状实心度", "0.92"), ("retry_cd", "无变化跳过(s)", "25")]
        for i, (k, label, _d) in enumerate(items):
            r, c = divmod(i, 4)
            b2.columnconfigure(c, weight=1)
            f = tk.Frame(b2, bg=PANEL)
            f.grid(row=r * 2, column=c, sticky="w", padx=(0, 26), pady=(6, 0))
            tk.Label(f, text=label, bg=PANEL, fg=SUB, font=(FONT, 8)).pack(anchor="w")
            v = tk.StringVar(value=str(self.cfg.get(k, _d)))
            self._entry(b2, v, width=10).grid(row=r * 2 + 1, column=c, sticky="w",
                                              padx=(0, 26), pady=(2, 6))
            if k in ("min_area", "max_area", "white_v"):
                b2.columnconfigure(c, weight=1)
            self.vars[k] = v
        opt = tk.Frame(b2, bg=PANEL)
        opt.grid(row=4, column=0, columnspan=4, sticky="w", pady=(4, 0))
        self.blue_only = tk.BooleanVar(value=bool(self.cfg["blue_only"]))
        self.debug = tk.BooleanVar(value=bool(self.cfg["debug"]))
        for txt, var in (("只点蓝框卡片", self.blue_only), ("显示识别预览", self.debug)):
            tk.Checkbutton(opt, text=txt, variable=var, bg=PANEL, fg=TEXT,
                           activebackground=PANEL, activeforeground=TEXT,
                           selectcolor=PANEL2, relief="flat", bd=0,
                           font=(FONT, 9), cursor="hand2").pack(side="left", padx=(0, 16))

        # ③ 控制 + 统计
        wrap3, b3 = self._card(self, "③ 运行控制")
        wrap3.pack(fill="x", padx=18, pady=(0, 8))
        ctl = tk.Frame(b3, bg=PANEL)
        ctl.pack(side="left")
        self.btn_start = _btn(ctl, "开始", kind="primary", cmd=self.start)
        self.btn_start.pack(side="left")
        _btn(ctl, "暂停 / 继续", cmd=self.toggle).pack(side="left", padx=(8, 0))
        _btn(ctl, "停止", cmd=self.stop).pack(side="left", padx=(8, 0))
        _btn(ctl, "保存配置", cmd=self.save).pack(side="left", padx=(8, 0))
        tk.Label(b3, text="F8 暂停 · F12 停止", bg=PANEL, fg=SUB,
                 font=(FONT, 8)).pack(side="left", padx=(14, 0))

        stats = tk.Frame(b3, bg=PANEL)
        stats.pack(side="right")
        self.stat_vals = {}
        for key, cap, color in (("rounds", "轮次", TEXT), ("clicks", "点击", ACCENT),
                                ("hits", "有效", OK), ("state", "状态", WARN)):
            tile = tk.Frame(stats, bg=PANEL2, highlightthickness=1,
                            highlightbackground=BORDER, padx=14, pady=4)
            tile.pack(side="left", padx=(8, 0))
            tk.Label(tile, text=cap, bg=PANEL2, fg=SUB, font=(FONT, 7)).pack(anchor="w")
            val = tk.Label(tile, text="0", bg=PANEL2, fg=color, font=(FONT, 13, "bold"))
            val.pack(anchor="w")
            self.stat_vals[key] = val
        self.stat = self.stat_vals["state"]

        # ④ 背包 / 仓库 / 魔方
        wrap4, b4 = self._card(self, "④ 背包 / 仓库 / 魔方", "点右下角金盾开面板，按 banner 相对位置点按钮")
        wrap4.pack(fill="x", padx=18, pady=(0, 8))
        self.bag = tk.BooleanVar(value=bool(self.cfg.get("bag", 0)))
        self.cube = tk.BooleanVar(value=bool(self.cfg.get("cube", 0)))
        self.panel_vars = {}
        row = tk.Frame(b4, bg=PANEL)
        row.pack(fill="x")
        tk.Checkbutton(row, text="定时巡检背包（满了自动存仓）", variable=self.bag, bg=PANEL, fg=TEXT,
                       activebackground=PANEL, activeforeground=TEXT, selectcolor=PANEL2,
                       relief="flat", bd=0, font=(FONT, 9), cursor="hand2").pack(side="left")
        for k, label, w in (("bag_interval", "间隔(s)", 7), ("wh_click", "存仓点击", 6)):
            f = tk.Frame(row, bg=PANEL)
            f.pack(side="left", padx=(14, 0))
            tk.Label(f, text=label, bg=PANEL, fg=SUB, font=(FONT, 8)).pack(side="left", padx=(0, 5))
            v = tk.StringVar(value=str(self.cfg.get(k)))
            self._entry(f, v, width=w).pack(side="left")
            self.panel_vars[k] = v
        _btn(row, "立即巡检一次", cmd=self.check_bag).pack(side="left", padx=(16, 0))

        row2 = tk.Frame(b4, bg=PANEL)
        row2.pack(fill="x", pady=(8, 0))
        tk.Checkbutton(row2, text="仓库也满时用魔方合成（会消耗 9 件同等级装备）", variable=self.cube,
                       bg=PANEL, fg=TEXT, activebackground=PANEL, activeforeground=TEXT,
                       selectcolor=PANEL2, relief="flat", bd=0, font=(FONT, 9),
                       cursor="hand2").pack(side="left")
        f = tk.Frame(row2, bg=PANEL)
        f.pack(side="left", padx=(14, 0))
        tk.Label(f, text="合成次数", bg=PANEL, fg=SUB, font=(FONT, 8)).pack(side="left", padx=(0, 5))
        v = tk.StringVar(value=str(self.cfg.get("cube_times")))
        self._entry(f, v, width=6).pack(side="left")
        self.panel_vars["cube_times"] = v
        tk.Label(row2, text="默认关闭：合成不可撤销，想用再打勾", bg=PANEL, fg=WARN,
                 font=(FONT, 8)).pack(side="left", padx=(14, 0))

        # ⑤ 预览 / 日志
        body = tk.Frame(self, bg=BG)
        body.pack(fill="both", expand=True, padx=18, pady=(0, 16))
        body.columnconfigure(0, weight=1, uniform="c")
        body.columnconfigure(1, weight=1, uniform="c")
        body.rowconfigure(0, weight=1, minsize=250)

        wrapL, bl = self._card(body, "识别预览")
        wrapL.grid(row=0, column=0, sticky="nsew", padx=(0, 8))
        self.canvas = tk.Label(bl, bg="#101114", bd=0, highlightthickness=0)
        self.canvas.pack(fill="both", expand=True)
        self._last_bgr = None
        self.canvas.bind("<Configure>", lambda e: self._render_preview())
        self.lbl_prev = tk.Label(bl, text="等待识别…", bg="#101114", fg=SUB,
                                 font=(MONO, 8), anchor="e")
        self.lbl_prev.pack(fill="x", pady=(4, 0))

        wrapR, br = self._card(body, "运行日志")
        wrapR.grid(row=0, column=1, sticky="nsew", padx=(8, 0))
        logbox = tk.Frame(br, bg="#101114")
        logbox.pack(fill="both", expand=True)
        self.txt = tk.Text(logbox, bg="#101114", fg="#C5CAD1", insertbackground=ACCENT,
                           relief="flat", bd=0, wrap="word", padx=10, pady=8,
                           font=(MONO, 9), selectbackground="#2F4C63")
        self.txt.pack(fill="both", expand=True)
        self._tags()

    def _tags(self):
        t = self.txt
        t.tag_config("time", foreground="#5B6270")
        t.tag_config("info", foreground="#C5CAD1")
        t.tag_config("ok", foreground=OK)
        t.tag_config("hit", foreground=ACCENT)
        t.tag_config("warn", foreground=WARN)
        t.tag_config("err", foreground=ERR)

    def region_text(self):
        if self.cfg.get("follow"):
            hwnd = self.cfg.get("hwnd")
            try:
                if hwnd and win32gui.IsWindow(hwnd):
                    l, t, r, b = win32gui.GetWindowRect(hwnd)
                    w, h = int(self.cfg.get("rel_w", 480)), int(self.cfg.get("rel_h", 200))
                    x = r - int(self.cfg.get("rel_right", 20)) - w
                    y = b - int(self.cfg.get("rel_bottom", 300))
                    return "跟随右下角 %d,%d %d×%d" % (x, y, w, h)
            except Exception:
                pass
            return "跟随右下角（待刷新）"
        r = self.cfg.get("region")
        if r:
            return "区域 %d,%d %d×%d" % tuple(r)
        return "跟随窗口（建议框选）"

    def log(self, m):
        tag = "info"
        if m.startswith("!!"):
            tag = "err"
        elif "点击" in m:
            tag = "hit"
        elif any(k in m for k in ("提示", "建议", "遮挡", "跳过", "未变化")):
            tag = "warn"
        elif any(k in m for k in ("引擎", "热键", "已保存", "已设置")):
            tag = "ok"
        self.txt.insert("end", time.strftime("%H:%M:%S  "), "time")
        self.txt.insert("end", m + "\n", tag)
        self.txt.see("end")
        try:
            if int(self.txt.index("end-1c").split(".")[0]) > 500:
                self.txt.delete("1.0", "120.0")
        except Exception:
            pass

    def refresh(self):
        self.windows = enum_windows()
        vals = ['[%d] %dx%d @(%d,%d) score=%d "%s" %s' % (
            i, w["rect"][2], w["rect"][3], w["rect"][0], w["rect"][1],
            w["score"], w["title"][:24], w["cls"][:22]) for i, w in enumerate(self.windows)]
        self.cb["values"] = vals
        if vals:
            idx = 0
            t = self.cfg.get("hwnd_title") or ""
            if t:
                for i, w in enumerate(self.windows):
                    if w["title"] == t:
                        idx = i
                        break
            self.cb.current(idx)
            sel = self.windows[idx]
            self.cfg["hwnd"] = sel["hwnd"]
            self.cfg["hwnd_title"] = sel["title"]
            if hasattr(self, "lbl_region"):
                self.lbl_region.config(text=self.region_text())
            self.log("发现 %d 个窗口，当前目标：%s  %dx%d @(%d,%d)" % (
                len(vals), sel["title"] or sel["cls"],
                sel["rect"][2], sel["rect"][3], sel["rect"][0], sel["rect"][1]))
            mon = self._sct.monitors[0]
            if sel["rect"][2] * sel["rect"][3] > 0.35 * mon["width"] * mon["height"]:
                self.log("提示：该窗口面积较大，建议点“框选区域”只框住宝箱出现的位置")

    def _toggle_follow(self):
        self.cfg["follow"] = bool(self.follow.get())
        if self.cfg["follow"]:
            self.cfg["region"] = None
        self.lbl_region.config(text=self.region_text())
        self.log("检测区域：%s" % ("跟随游戏窗口右下角" if self.cfg["follow"] else "使用框选区域"))

    def pull_cfg(self):
        for k, var in self.vars.items():
            txt = var.get().strip()
            try:
                val = float(txt) if k in FLOAT_KEYS else int(float(txt))
            except ValueError:
                self.log("参数 %s 输入无效，保留原值" % k)
                continue
            self.cfg[k] = val
        self.cfg["blue_only"] = bool(self.blue_only.get())
        self.cfg["debug"] = bool(self.debug.get())
        for k, var in getattr(self, "panel_vars", {}).items():
            try:
                self.cfg[k] = int(float(var.get().strip()))
            except ValueError:
                self.log("参数 %s 输入无效，保留原值" % k)
        if hasattr(self, "bag"):
            self.cfg["bag"] = bool(self.bag.get())
        if hasattr(self, "cube"):
            self.cfg["cube"] = bool(self.cube.get())
        if hasattr(self, "follow"):
            self.cfg["follow"] = bool(self.follow.get())
        i = self.cb.current()
        if i >= 0:
            self.cfg["hwnd"] = self.windows[i]["hwnd"]
            self.cfg["hwnd_title"] = self.windows[i]["title"]
        return self.cfg

    # ---- 区域框选 ----
    def select_region(self):
        alive = bool(self.eng and self.eng.is_alive())
        was_paused = bool(self.eng and self.eng.paused)
        if alive:
            self.eng.paused = True
            self.log("框选期间已暂停引擎")
        sw, sh = self.winfo_screenwidth(), self.winfo_screenheight()
        ov = tk.Toplevel(self)
        ov.overrideredirect(True)
        ov.attributes("-topmost", True)
        ov.attributes("-alpha", 0.42)
        ov.geometry("%dx%d+0+0" % (sw, sh))
        cv = tk.Canvas(ov, bg="#0B0C0F", highlightthickness=0, cursor="cross")
        cv.pack(fill="both", expand=True)
        cv.create_text(sw // 2, 40, text="按住鼠标左键框出宝箱出现的区域 · Esc 取消",
