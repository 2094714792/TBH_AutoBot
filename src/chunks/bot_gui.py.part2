    hits = []
    for sc in (0.90, 0.94, 0.97, 1.00, 1.03, 1.06, 1.10):
        t = cv2.resize(tpl, None, fx=sc, fy=sc, interpolation=cv2.INTER_AREA)
        if t.shape[0] >= H or t.shape[1] >= W:
            continue
        res = cv2.matchTemplate(img, t, cv2.TM_CCOEFF_NORMED)
        ys, xs = np.where(res >= thr)
        for y, x in zip(ys, xs):
            hits.append((float(res[y, x]), int(x), int(y), t.shape[1], t.shape[0]))
    picks = []
    for s, x, y, w, h in sorted(hits, reverse=True):
        if all(abs(x - px) > w * 0.55 or abs(y - py) > h * 0.55 for _s, px, py, _w, _h in picks):
            picks.append((s, x, y, w, h))
        if len(picks) >= 5:
            break
    cards = [dict(box=(x, y, w, h), center=(x + w // 2, y + h // 2), blue=False,
                  score=s, fill=1.0, rect=1.0, blue_frac=0.0, tpl=True)
             for s, x, y, w, h in picks]
    cards.sort(key=lambda c: c["center"][0])
    return cards


def draw_debug(img, cards, region, extra=""):
    dbg = img.copy()
    for c in cards:
        x, y, w, h = c["box"]
        col = (255, 120, 0) if c["blue"] else (0, 220, 0)
        cv2.rectangle(dbg, (x, y), (x + w, y + h), col, 2)
        cv2.putText(dbg, "%s %.2f" % ("BLUE" if c["blue"] else "card", c["score"]),
                    (x, max(12, y - 4)), cv2.FONT_HERSHEY_SIMPLEX, 0.42, col, 1)
    cv2.putText(dbg, "region=%s %s" % (region, extra), (4, 14),
                cv2.FONT_HERSHEY_SIMPLEX, 0.42, (220, 220, 220), 1)
    return dbg


# ---------------- 游戏内面板（背包 / 仓库 / 魔方） ----------------
# 实测：右下角「金盾」按钮(25×29) → 英雄面板（含背包格/页签/底部五枚六边形功能键）
# 面板位置随开合数量左右平移，所以一律按「banner 相对偏移」定位，不用屏幕绝对坐标。
SHIELD_TPL = "arrow_icon.png"
HEX_OFF = (-49, 12, 74, 139, 204)      # 商店 / 铁匠 / 仓库 / 魔方 / 宝石（相对 banner 左边）
HEX_DY = 385                            # 六边形行 y（相对 banner 顶）
BAG_ROI = (-62, 195, 250, 135)          # 背包格子区（相对 banner 左上 dx,dy,w,h）
WH_STORE = (88, 405)                    # 仓库面板里「仓库<背包」（仓库>背包在 -4）
CUBE_FILL = (27, 300)                   # 魔方「自动填充」
CUBE_MERGE = (110, 300)                 # 魔方右侧「✚ 合成」


def grab_all(sct):
    mon = sct.monitors[0]
    return np.array(sct.grab(mon))[:, :, :3].copy()


def find_banners(img):
    """面板顶部的暗红标题带（y≈430、高≈32），用来判断有哪些面板开着"""
    b, g, r = img[:, :, 0].astype(int), img[:, :, 1].astype(int), img[:, :, 2].astype(int)
    m = ((r > 85) & (r < 180) & (g < 72) & (b < 72)).astype(np.uint8)
    m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8))
    n, _l, st, _c = cv2.connectedComponentsWithStats(m, 8)
    out = []
    for i in range(1, n):
        x, y, w, h, a = (int(v) for v in st[i])
        if a > 2200 and w > 100 and 16 < h < 70:
            out.append((x, y, w, h))
    out.sort()
    return out


class PanelBot(threading.Thread):
    """每 N 秒一轮：金盾开英雄面板 → 读背包占用 → 满了去仓库点「仓库<背包」
       → 仓库也满且开启合成时，走魔方「自动填充 + 合成」。
       任何一步没校验通过就放弃并退回，绘不盲点。"""

    def __init__(self, cfg, logq, eng=None):
        super().__init__(daemon=True)
        self.cfg, self.logq, self.eng = cfg, logq, eng
        self._stop = threading.Event()
        self.sct = None          # mss 句柄不能跨线程，首次截图时建（可能在别的线程里跑）
        self.last_run = 0.0
        self.bag = -1.0

    def log(self, m):
        self.logq.put(("log", "【面板】" + m))

    def stop(self):
        self._stop.set()

    # ---- 基础 ----
    def _shot(self):
        if self.sct is None:
            self.sct = new_sct()
        return grab_all(self.sct)

    def _click(self, x, y, what=""):
        pg.moveTo(int(x), int(y), duration=0.10)
        time.sleep(0.12)
        pg.click()
        time.sleep(0.55)

    def _shield(self, img):
        tpl = load_tpl(SHIELD_TPL)
        if tpl is None:
            return None
        best = None
        for sc in (0.85, 0.9, 0.95, 1.0, 1.05, 1.1, 1.2):
            t = cv2.resize(tpl, None, fx=sc, fy=sc, interpolation=cv2.INTER_AREA)
            res = cv2.matchTemplate(img, t, cv2.TM_CCOEFF_NORMED)
            _mn, mx, _mnl, mxl = cv2.minMaxLoc(res)
            if mx >= 0.72 and (best is None or mx > best[0]):
                best = (mx, mxl[0] + t.shape[1] // 2, mxl[1] + t.shape[0] // 2)
        return best

    def _bag_ratio(self, img, banner):
        bx, by = banner[0], banner[1]
        dx, dy, w, h = BAG_ROI
        x0, y0 = max(0, bx + dx), max(0, by + dy)
        x1, y1 = min(img.shape[1], x0 + w), min(img.shape[0], y0 + h)
        if x1 - x0 < 60 or y1 - y0 < 60:
            return -1.0
        roi = img[y0:y1, x0:x1]
        hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
        s, v = hsv[:, :, 1].astype(int), hsv[:, :, 2].astype(int)
        return float(((v > 105) & (s > 55)).mean())

    def _open_hero(self):
        img = self._shot()
        bn = find_banners(img)
        for _ in range(2):
            if bn:
                return img, bn
            sh = self._shield(img)
            if not sh:
                self.log("看不到右下角金盾按钮，跳过")
                return img, []
            self._click(sh[1], sh[2], "金盾")
            img = self._shot()
            bn = find_banners(img)
        return img, bn

    def _open_hex(self, hero, idx, name):
        """点英雄面板底部的六边形功能键，返回新面板 banner；没开出来就返回 None"""
        x, y = hero[0] + HEX_OFF[idx], hero[1] + HEX_DY
        base = find_banners(self._shot())
        for _ in range(2):
            self._click(x, y, name)
            bn = find_banners(self._shot())
            new = [b for b in bn if not any(abs(b[0] - o[0]) < 26 and abs(b[1] - o[1]) < 26 for o in base)]
            if new:
                return max(new)
            time.sleep(0.5)
        self.log("%s面板没开出来（按钮可能被开/关切换了）" % name)
        return None

    # ---- 一轮巡检 ----
    def cycle(self):
        hwnd = self.cfg.get("hwnd")
        if hwnd and win32gui.IsWindow(hwnd) and win32gui.GetForegroundWindow() != hwnd:
            self.log("游戏窗口不在前台，为免点到别的软件，本轮不执行")
            return
        img, bn = self._open_hero()
        if not bn:
            return
        hero = bn[-1]
        before = self._bag_ratio(img, hero)
        self.bag = before
        self.log("背包占用参考值 %.0f%%" % (before * 100) if before >= 0 else "背包格子区没认出来")
        wb = self._open_hex(hero, 2, "仓库")
        if not wb:
            return
        # 存仓是幂等操作：背包空的时候点它什么也不会发生，所以不需要先判断“满”
        for _ in range(int(self.cfg.get("wh_click", 3))):
            self._click(wb[0] + WH_STORE[0], wb[1] + WH_STORE[1], "仓库<背包")
        img2 = self._shot()
        bn2 = find_banners(img2)
        # 最右边那块是英雄面板（背包格子属于它）；仓库 / 魔方 在它左边
        after = self._bag_ratio(img2, max(bn2) if bn2 else hero)
        self.log("已点 %d 次「仓库<背包」，背包占用 %.0f%% → %.0f%%" % (
            int(self.cfg.get("wh_click", 3)), before * 100, after * 100))
        if self.cfg.get("cube"):
            cb = self._open_hex(hero, 3, "魔方")
            if not cb:
                return
            n = int(self.cfg.get("cube_times", 3))
            for i in range(n):
                self._click(cb[0] + CUBE_FILL[0], cb[1] + CUBE_FILL[1], "自动填充")
                self._click(cb[0] + CUBE_MERGE[0], cb[1] + CUBE_MERGE[1], "合成")
                self.log("魔方第 %d/%d 次：自动填充 + 合成" % (i + 1, n))
                time.sleep(0.5)
        else:
            self.log("魔方合成未开启（会消耗 9 件同等级装备），本轮只存仓")

    def esc(self, n=4):
        """关面板。只在游戏仍在前台时发 Esc，免得把 Esc 送到别的软件。"""
        hwnd = self.cfg.get("hwnd")
        try:
            if hwnd and win32gui.IsWindow(hwnd) and win32gui.GetForegroundWindow() != hwnd:
                return
        except Exception:
            return
        for _ in range(n):
            pg.press("escape")
            time.sleep(0.18)

    def run(self):
        while not self._stop.is_set():
            time.sleep(0.5)
            try:
                if not self.cfg.get("bag"):
                    continue
                if time.time() - self.last_run < float(self.cfg.get("bag_interval", 600)):
                    continue
                hwnd = self.cfg.get("hwnd")
                if not hwnd or not win32gui.IsWindow(hwnd):
                    continue
                if win32gui.GetForegroundWindow() != hwnd:
                    continue                      # 游戏不在前台就别乱点
                self.last_run = time.time()
                paused = None
                if self.eng is not None:
                    paused = self.eng.paused
                    self.eng.paused = True
                try:
                    self.cycle()
                finally:
                    self.esc(4)
                    if self.eng is not None:
                        self.eng.paused = bool(paused)
            except Exception as e:
                self.log("巡检异常：%s" % e)
                try:
                    self.esc(2)
                except Exception:
                    pass


# ---------------- 引擎 ----------------
class Engine(threading.Thread):
    def __init__(self, cfg, logq, imgq):
        super().__init__(daemon=True)
        self.cfg, self.logq, self.imgq = cfg, logq, imgq
        self._stop_evt = threading.Event()
        self.paused = False
        self.clicks = 0
        self.rounds = 0
        self.hits = 0
        self.last_fire = 0.0
        self.retry = {}
        self.skip_until = {}
        self.err_streak = 0
        self.last_err = ""

    def stop(self):
        self._stop_evt.set()

    def log(self, m):
        self.logq.put(("log", m))

    def _foreground_ok(self, hwnd):
        """游戏是 WS_EX_TRANSPARENT 的置顶窗口：不在前台时鼠标点击会穿透到下面
           的桌面/别的软件——这正是“累计454次点击、画面纹丝不动”的根源。
           所以只在游戏位于前台时才点击；若前台是本程序自己的窗口，顺手把它切回前台。"""
        try:
            fg = win32gui.GetForegroundWindow()
        except Exception:
            return True
        if not fg or fg == hwnd:
            return True
        pid = ctypes.c_ulong()
        try:
            ctypes.windll.user32.GetWindowThreadProcessId(fg, ctypes.byref(pid))
