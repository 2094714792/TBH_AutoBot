# -*- coding: utf-8 -*-
"""TBH 自动挂机助手 v1.2
   宝箱卡片自动识别点击 + 背包/仓库/魔方巡检
   - 点击只在前台生效：游戏是透明置顶窗口，不在前台时点击会穿透到桌面/别的软件
   - 检测区域默认跟随游戏窗口右下角（游戏窗口会随面板开合改变尺寸/位置）
   - 卡片识别：模板匹配 → 白色阈值(严) → 白色阈值(松)，白底网页压着卡片也能认
   - 面板坐标一律按顶部 banner 的相对偏移算，不用屏幕绝对坐标
   - 点击后校验画面是否变化，同一位置反复无变化自动跳过
   - 采集线程独立 mss 实例、单轮异常不退出、热键通过主线程调度
"""
import ctypes, json, os, queue, sys, threading, time, random, traceback

import cv2, mss, numpy as np
import win32gui, win32con
import pyautogui as pg
from PIL import Image, ImageTk
import tkinter as tk
from tkinter import ttk, messagebox

try:
    ctypes.windll.shcore.SetProcessDpiAwareness(2)
except Exception:
    try:
        ctypes.windll.user32.SetProcessDPIAware()
    except Exception:
        pass

pg.FAILSAFE = True

if getattr(sys, "frozen", False):
    BASE_DIR = os.path.dirname(os.path.abspath(sys.executable))
else:
    BASE_DIR = os.path.dirname(os.path.abspath(__file__))
CFG_PATH = os.path.join(BASE_DIR, "config.json")

DEFAULT = dict(
    hwnd_title="", interval=0.8, card_cd=1.0, region=None,
    follow=1, rel_w=480, rel_h=200, rel_right=20, rel_bottom=300,
    pad_up=140, pad_side=20,
    white_v=216, white_s=46, white_v_low=196, white_s_low=62,
    min_area=600, max_area=9000,
    solid_min=0.92, rect_min=0.85, edge_min=0.60, blue_frac=0.30, card_diff=6.0,
    blue_only=False, max_retry=4, retry_cd=25.0, debug=True,
    bag=0, bag_interval=600, wh_click=3, cube=0, cube_times=3,
)
FLOAT_KEYS = ("interval", "card_cd", "retry_cd", "card_diff", "solid_min", "rect_min")


def new_sct():
    """每个线程各自持有一个 mss 实例（mss 的 GDI 句柄不跨线程共享）"""
    return mss.mss() if hasattr(mss, "mss") else mss.MSS()


# ---------------- 窗口 ----------------
SKIP_CLASS = ("Shell_TrayWnd", "Shell_SecondaryTrayWnd", "Progman", "WorkerW",
              "Windows.UI.Core.CoreWindow", "ApplicationManager", "TaskBarHero_Helper")


def enum_windows():
    """枚举候选窗口，排除任务栏/桌面/本程序自身"""
    out = []
    me = os.getpid()

    def cb(h, _):
        try:
            if not win32gui.IsWindowVisible(h) or win32gui.IsIconic(h):
                return
            l, t, r, b = win32gui.GetWindowRect(h)
            w, ht = r - l, b - t
            if w < 120 or ht < 25:
                return
            cls = win32gui.GetClassName(h)
            if any(k in cls for k in ("Chrome", "Mozilla", "CefBrowser")):
                return
            if cls in SKIP_CLASS or cls.startswith("Tk"):
                return
            pid = ctypes.c_ulong()
            ctypes.windll.user32.GetWindowThreadProcessId(h, ctypes.byref(pid))
            if pid.value == me:
                return
            ex = win32gui.GetWindowLong(h, win32con.GWL_EXSTYLE)
            s = 0
            if w / max(ht, 1) >= 2.0:
                s += 2
            if ht < 260:
                s += 2
            if ex & 0x80000:      # WS_EX_LAYERED
                s += 2
            if ex & 0x80:         # WS_EX_TOOLWINDOW
                s += 1
            if win32gui.GetWindowText(h) == "":
                s += 1
            out.append(dict(hwnd=h, cls=cls, title=win32gui.GetWindowText(h),
                            rect=(l, t, w, ht), score=s))
        except Exception:
            pass

    win32gui.EnumWindows(cb, None)
    return sorted(out, key=lambda d: (-d["score"], -d["rect"][1]))


def resolve_region(sct, cfg):
    """优先跟随游戏窗口右下角；否则用框选区域 / 窗口矩形"""
    mon = sct.monitors[0]
    hwnd = cfg.get("hwnd")
    if cfg.get("follow") and hwnd and win32gui.IsWindow(hwnd):
        l, t, r, b = win32gui.GetWindowRect(hwnd)
        w, h = int(cfg.get("rel_w", 480)), int(cfg.get("rel_h", 200))
        rm, bm = int(cfg.get("rel_right", 20)), int(cfg.get("rel_bottom", 300))
        l = r - rm - w
        t = b - bm
        w, h = w, h
    else:
        reg = cfg.get("region")
        if reg:
            try:
                l, t, w, h = (int(v) for v in reg)
            except Exception:
                l = t = w = h = 0
            if w <= 0 or h <= 0:
                raise RuntimeError("框选区域无效")
        else:
            if not hwnd:
                raise RuntimeError("未选择窗口，也没有框选区域")
            if not win32gui.IsWindow(hwnd):
                raise RuntimeError("目标窗口已关闭")
            l, t, r, b = win32gui.GetWindowRect(hwnd)
            w, h = r - l, b - t
            pu, ps = int(cfg["pad_up"]), int(cfg["pad_side"])
            l, t = l - ps, t - pu
            w, h = w + 2 * ps, h + pu
    x0, y0 = max(l, mon["left"]), max(t, mon["top"])
    x1 = min(l + w, mon["left"] + mon["width"])
    y1 = min(t + h, mon["top"] + mon["height"])
    if x1 - x0 < 24 or y1 - y0 < 16:
        raise RuntimeError("检测区域落在屏幕外或过小：%s" % ((l, t, w, h),))
    return (x0, y0, x1 - x0, y1 - y0)


def point_blocked(x, y, hwnd):
    """该点是否被“别的程序”挡住。桌面/任务栏/游戏自身窗口一律不算遮挡。
       返回 (blocked, 说明)。"""
    if not hwnd:
        return False, ""
    try:
        h = win32gui.WindowFromPoint((x, y))
    except Exception:
        return False, ""
    if not h:
        return False, ""
    try:
        cls = win32gui.GetClassName(h)
        if cls in SKIP_CLASS or cls.startswith("Tk"):
            return False, ""
        if cls == "SysListView32" or win32gui.GetWindowText(h) == "FolderView":
            return False, ""                      # 桌面图标层
        gp = ctypes.c_ulong()
        pp = ctypes.c_ulong()
        ctypes.windll.user32.GetWindowThreadProcessId(hwnd, ctypes.byref(gp))
        ctypes.windll.user32.GetWindowThreadProcessId(h, ctypes.byref(pp))
        if gp.value and pp.value == gp.value:
            return False, ""                      # 游戏自己的窗口
        r = win32gui.GetWindowRect(h)
        if not (r[0] <= x < r[2] and r[1] <= y < r[3]):
            return False, ""
        ex = win32gui.GetWindowLong(h, win32con.GWL_EXSTYLE)
        if ex & 0x20:                             # WS_EX_TRANSPARENT 点击穿透
            return False, ""
        return True, "%s|%s" % (cls, win32gui.GetWindowText(h)[:28])
    except Exception:
        return False, ""


def grab(sct, region):
    l, t, w, h = region
    if w <= 0 or h <= 0:
        raise RuntimeError("区域无效 %s" % (region,))
    return np.array(sct.grab({"left": l, "top": t, "width": w, "height": h}))[:, :, :3].copy()


# ---------------- 卡片识别 ----------------
def find_cards(img, cfg, loose=False):
    """近白卡片 + 灰色边框环校验 → [{box, center, blue, score}]"""
    v = int(cfg["white_v_low"] if loose else cfg["white_v"])
    s = int(cfg["white_s_low"] if loose else cfg["white_s"])
    hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
    white = ((hsv[:, :, 2] >= v) & (hsv[:, :, 1] <= s)).astype(np.uint8)
    if not white.any():
        return []
    white = cv2.morphologyEx(white, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))
    n, lab, stats, cent = cv2.connectedComponentsWithStats(white, 8)
    H, W = white.shape
    cards = []
    for i in range(1, n):
        x, y, w, h, a = (int(v2) for v2 in stats[i])
        if a < cfg["min_area"] or a > cfg["max_area"]:
            continue
        if w < 16 or h < 12:
            continue
        aspect = w / float(h)
        if aspect < 0.9 or aspect > 2.2:
            continue
        fill = a / float(w * h)
        if fill < 0.42:
            continue
        # ---- 形状校验：卡片是规整的圆角矩形，白色特效/壁纸/烟雾过不了 ----
        m = (lab[y:y + h, x:x + w] == i).astype(np.uint8)
        cnts, _ = cv2.findContours(m, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not cnts:
            continue
        cnt = max(cnts, key=cv2.contourArea)
        ca = cv2.contourArea(cnt)
        hull = cv2.convexHull(cnt)
        solid = ca / max(cv2.contourArea(hull), 1.0)
        rect = ca / float(w * h)
        verts = len(cv2.approxPolyDP(cnt, 0.02 * cv2.arcLength(cnt, True), True))
        band = 2
        edge = float(np.mean([m[:band, :].mean(), m[-band:, :].mean(),
                              m[:, :band].mean(), m[:, -band:].mean()]))
        if solid < cfg["solid_min"] or rect < cfg["rect_min"] or edge < cfg["edge_min"]:
            continue
        if verts > 8:
            continue
        # ---- 蓝框判定：只看卡片自己的边框带（不再受背景颜色影响）----
        bh = hsv[y + 1:y + h - 1, x + 1:x + w - 1]
        bm = np.zeros((max(h - 2, 1), max(w - 2, 1)), bool)
        bm[:2, :] = bm[-2:, :] = True
        bm[:, :2] = bm[:, -2:] = True
        band_px = bh[bm] if bh.size else np.zeros((0, 3), np.uint8)
        blue_frac = 0.0
        if len(band_px) >= 20:
            blue_frac = np.count_nonzero(
                (band_px[:, 0] >= 88) & (band_px[:, 0] <= 142) &
                (band_px[:, 1] >= 85) & (band_px[:, 2] >= 60)) / float(len(band_px))
        is_blue = blue_frac >= cfg["blue_frac"]
        cards.append(dict(box=(x, y, w, h), center=(x + w // 2, y + h // 2),
                          blue=is_blue, score=float(solid), fill=float(fill),
                          rect=float(rect), blue_frac=float(blue_frac)))
    cards.sort(key=lambda c: (not c["blue"], c["center"][0]))
    return cards


_TPL_CACHE = {}


def load_tpl(name):
    """读取与程序同目录的模板图（card_tpl.png 等）"""
    if name in _TPL_CACHE:
        return _TPL_CACHE[name]
    img = None
    p = os.path.join(BASE_DIR, name)
    if os.path.exists(p):
        try:
            img = cv2.imread(p)
        except Exception:
            img = None
    _TPL_CACHE[name] = img
    return img


def find_cards_tpl(img, cfg, thr=None):
    """模板匹配找宝箱卡片：白色窗口/网页挡在后面也能认出（白底会吞掉白色阈值法）"""
    tpl = load_tpl("card_tpl.png")
    if tpl is None:
        return []
    H, W = img.shape[:2]
    if H < tpl.shape[0] + 6 or W < tpl.shape[1] + 6:
        return []
    thr = float(cfg.get("tpl_score", 0.62)) if thr is None else thr
